# Copy this file to .env.local and fill in the values from your Supabase project
# (Supabase dashboard -> Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY

# Public seller-payment instructions are read server-side on /seller/billing.
# Fill these only with TradeBridge's officially approved receiving details.
TRADEBRIDGE_MTN_MOMO_NUMBER=
TRADEBRIDGE_MTN_MOMO_ACCOUNT_NAME=
TRADEBRIDGE_MTN_MOMO_INSTRUCTIONS=
TRADEBRIDGE_EQUITY_ACCOUNT_NAME=
TRADEBRIDGE_EQUITY_ACCOUNT_NUMBER=
TRADEBRIDGE_EQUITY_BRANCH=
TRADEBRIDGE_EQUITY_INSTRUCTIONS=
